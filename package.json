{
  "name": "kongxiang-incremental",
  "version": "0.6.5",
  "private": true,
  "description": "空想增量 —— 网页增量游戏（原生 ES 模块 + break_eternity.js，零构建）",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "空想增量",
  "license": "MIT",
  "scripts": {
    "serve": "node serve.mjs",
    "start": "node serve.mjs",
    "electron": "electron .",
    "smoke": "node tools/smoke-protocol.cjs",
    "smoke:electron": "electron --no-sandbox tools/smoke-electron.cjs",
    "check:web": "node tools/check-web-bundle.cjs",
    "test": "node tools/run-all.mjs",
    "sim:infinity": "node tools/infinity-sim.mjs",
    "sim:infinity:check": "node tools/infinity-sim.mjs --check",
    "pace": "node tools/pace-model.mjs",
    "pace:check": "node tools/pace-model.mjs --check",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:dir": "electron-builder --win --x64 --dir --publish never"
  },
  "//为什么没有 dependencies": "游戏本体零依赖：break_eternity.js 已经以 dist/ 的形式内置，src/ 直接 import 它。只想玩网页版的话完全不用 npm install。",
  "//为什么需要 devDependencies": "只有「打包成 exe」和「桌面端调试」才需要 electron / electron-builder。",
  "//为什么需要 serve": "index.html 里的 src/main.js 是 type=\"module\"，file:// 协议下会被 CORS 拦掉，必须走 HTTP。Electron 里由 electron/main.cjs 注册的 app:// 协议代劳。",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.kongxiang.incremental",
    "productName": "空想增量",
    "copyright": "MIT Licensed · break_eternity.js by Patashu",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "css/**/*",
      "src/**/*",
      "dist/**/*",
      "electron/**/*",
      "LICENSE",
      "!**/*.map"
    ],
    "compression": "normal",
    "//产物名为什么用 ASCII": "中文 exe 名在部分下载/CI 环境下会被转义或乱码；productName 仍是「空想增量」，只影响文件名",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KongxiangIncremental-${version}-win-${arch}.${ext}"
    }
  }
}
